{
    "name": "shell-blocks-backend",
    "private": true,
    "version": "1.0.0",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "test": "npm run test:all",
        "test:quick": "vitest run --exclude tests/integration/**",
        "test:integration": "vitest run tests/integration",
        "test:all": "npm run test:quick && npm run test:integration",
        "type-check": "tsc --noEmit",
        "type-check:test": "tsc --noEmit -p tsconfig.test.json",
        "build": "node esbuild.config.mjs",
        "start": "node --env-file=.env dist/server.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@shellblocks/shared": "file:../shared",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.1",
        "esbuild": "^0.28.0",
        "esbuild-raw-plugin": "^0.3.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
